# Copy to .env.local and fill in. Never commit real values.
# Tip: after linking the project with `vercel link`, `vercel env pull .env.local` downloads them.

# Neon Postgres (Vercel dashboard -> Storage -> Create Database -> Neon, free plan)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Better Auth
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# The public URL of the app (http://localhost:9002 in development)
BETTER_AUTH_URL=http://localhost:9002

# Optional: Google sign-in (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID)
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (Dashboard -> Settings -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: AI document tagging (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Email for verification and password-reset links.
# Free option: a Gmail account with 2-Step Verification and an App Password.
# If unset in development, emails are printed to the terminal instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CourtCaseFlow <your-address@gmail.com>
